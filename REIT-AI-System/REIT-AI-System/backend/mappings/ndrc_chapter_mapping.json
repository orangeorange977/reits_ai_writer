            {"id": "asset_type", "label": "资产类型", "type": "select", "required": true, "options": ["产业园区", "数据中心", "仓储物流", "保障性租赁住房", "收费公路", "消费基础设施", "能源基础设施", "水利设施", "市政基础设施"]},
            {"id": "project_location", "label": "项目位置", "type": "text", "required": true},
            {"id": "originator", "label": "原始权益人（发起人）", "type": "text", "required": true},
            {"id": "project_company", "label": "项目公司", "type": "text", "required": true},
            {"id": "operation_manager", "label": "运营管理机构", "type": "text", "required": true},
            {"id": "fund_manager", "label": "基金管理人", "type": "text", "required": true},
            {"id": "abs_manager", "label": "资产支持证券管理人", "type": "text", "required": true},
            {"id": "fund_scale", "label": "拟发行基金规模（亿元）", "type": "text", "required": true},
            {"id": "asset_valuation", "label": "基础设施资产评估值（亿元）", "type": "text", "required": true},
            {"id": "total_area", "label": "项目总面积/规模", "type": "text", "required": true},
            {"id": "operation_years", "label": "已运营年限", "type": "text", "required": true},
            {"id": "distribution_rate", "label": "预计现金分派率", "type": "text"},
            {"id": "base_date", "label": "基准日", "type": "date", "required": true},
            {"id": "project_description", "label": "项目概况描述", "type": "textarea", "required": true},
            {
                          "id": "infrastructure_assets",
                          "label": "表1 项目概况",
                          "type": "form_table",
                          "rows": [
                            {"label": "项目名称", "id": "project_name"},
                            {"label": "基础设施类型", "id": "infra_type"},
                            {"label": "项目所在地", "id": "project_location"},
                            {"label": "项目建设内容及规模", "id": "project_scale"},
                            {"label": "开工时间", "id": "start_time"},
                            {"label": "竣工时间", "id": "completion_time"},
                            {"label": "投入运营时间", "id": "operation_time"},
                            {"label": "项目总投资", "id": "total_investment"},
                            {"label": "当前运营状态", "id": "operation_status"},
                            {"label": "最近3年平均出租率/使用率", "id": "occupancy_rate_3yr"}
                          ]
                        }
          ]
        },
        {
          "id": "1-2",
          "title": "（二）特殊限定情况说明",
          "fields": [
            {"id": "special_restrictions", "label": "特殊限定情况", "type": "textarea"},
            {"id": "land_use_restrictions", "label": "土地使用权限制条件", "type": "textarea"},
            {"id": "mortgage_pledge", "label": "抵押质押情况", "type": "textarea"},
            {"id": "lease_restrictions", "label": "租赁限制情况", "type": "textarea"},
            {"id": "risk_factors", "label": "主要风险因素", "type": "textarea"},
            {"id": "risk_mitigation", "label": "风险化解措施", "type": "textarea"}
          ]
        },
        {
          "id": "1-3",
          "title": "（三）可扩募资产情况",
          "fields": [
            {"id": "has_expandable_assets", "label": "是否有可扩募资产", "type": "select", "options": ["是", "否"], "required": true},
            {"id": "expandable_assets", "label": "表2 可扩募资产清单", "type": "table", "columns": ["资产名称", "位置", "面积/规模", "运营状态", "预计纳入时间"]},
            {"id": "expansion_plan", "label": "扩募计划说明", "type": "textarea"},
            {"id": "expansion_criteria", "label": "扩募资产筛选标准", "type": "textarea"}
          ]
        }
      ]
    },
