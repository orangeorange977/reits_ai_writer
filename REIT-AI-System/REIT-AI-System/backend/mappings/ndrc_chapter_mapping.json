{
  "version": "2024",
  "document_type": "发改委申报材料",
  "description": "基础设施领域不动产投资信托基金（REITs）项目申报材料格式文本（2024年版）",
  "summary_table": {
    "title": "摘要表",
    "description": "项目申报材料首页摘要信息",
    "fields": [
      {"id": "summary_project_name", "label": "项目名称", "type": "text", "required": true},
      {"id": "summary_industry_field", "label": "行业领域", "type": "text", "required": true, "placeholder": "如交通基础设施（收费公路）"},
      {"id": "summary_asset_location", "label": "资产所在地（明确到县区级）", "type": "text", "required": true, "placeholder": "XX省XX市XX区"},
      {"id": "summary_asset_scope", "label": "资产范围", "type": "textarea", "required": true, "placeholder": "线性工程填写起止地点，非线性工程填写项目四至"},
      {"id": "summary_construction_scale", "label": "建设规模合计（万元）", "type": "number", "required": true},
      {"id": "summary_first_or_new", "label": "首次发行项目/新购入项目", "type": "select", "required": true, "options": ["首次发行项目", "新购入项目"]},
      {"id": "summary_base_date", "label": "申报基准日", "type": "date", "required": true, "placeholder": "财务及估值数据基准日"},
      {"id": "summary_appraisal_net_value", "label": "不动产评估净值（万元）", "type": "number", "required": true},
      {"id": "summary_fund_total", "label": "拟发售基金总额（万元）", "type": "number", "required": true},
      {"id": "summary_originator_subscribe_ratio", "label": "原始权益人及相关方认购基金比例", "type": "text", "required": true},
      {"id": "summary_net_recovery_fund", "label": "净回收资金（万元）", "type": "number", "required": true},
      {"id": "summary_reinvestment_amount", "label": "其中，拟用于在建项目、前期工作成熟的新建项目（含改扩建）和存量资产收购的金额（万元）", "type": "text", "required": true, "placeholder": "合计金额及占净回收资金比例（%）"},
      {"id": "summary_listing_venue", "label": "拟上市场所", "type": "select", "required": true, "options": ["上海证券交易所", "深圳证券交易所"]},
      {"id": "summary_sponsor", "label": "发起人（如有）", "type": "text", "placeholder": "填写全称"},
      {"id": "summary_originator", "label": "原始权益人", "type": "text", "required": true, "placeholder": "填写全称"},
      {"id": "summary_fund_manager", "label": "基金管理人", "type": "text", "required": true, "placeholder": "填写全称"},
      {"id": "summary_abs_manager", "label": "资产支持证券管理人", "type": "text", "required": true, "placeholder": "填写全称"},
      {"id": "summary_law_firm", "label": "律师事务所及项目主办律师", "type": "text", "required": true, "placeholder": "填写全称及项目主办律师名称"},
      {"id": "summary_accounting_firm", "label": "会计师事务所", "type": "text", "required": true, "placeholder": "填写全称"},
      {"id": "summary_appraisal_firm", "label": "资产评估机构", "type": "text", "required": true, "placeholder": "填写全称"},
      {"id": "summary_tax_consultant", "label": "税务咨询机构（如有）", "type": "text", "placeholder": "填写全称"},
      {"id": "summary_securities_consultant", "label": "担任财务顾问的证券公司（如有）", "type": "text", "placeholder": "填写全称"}
    ]
