# Python 运行产物
__pycache__/
*.pyc
.venv/

# 密钥（含真实 Kimi/天眼查密钥，绝不可入库）
.env

# 运行期数据库和输出
workspace/

# 运行日志与依赖标记
server_*.log
.deps_installed

# 生成的 Word 文档（官方模板例外保留）
*.docx
!backend/templates/official/*.docx
!templates-packs/*/*.docx

# 调试用临时脚本（不进仓库）
.tmp_*
.deploy_*.py
.run_*.py

# 运行期数据库文件
backend/database/*.db

# 本地生成的 PDF 产物（不进仓库）
/第*.pdf
/摘要和释义表.pdf

# 本地运行日志与旧归档（不进仓库）
server_*.log
Archive/
Archive.zip
