{# 基础模板 - 通用宏定义 #}
{# 用于发改委申报材料各章节模板的公共宏 #}

{# 渲染字段（带默认值） #}
{% macro field(value, default="[待填写]") -%}
{{ value if value else default }}
{%- endmacro %}

{# 渲染段落（带首行缩进） #}
{% macro paragraph(text) -%}
{% if text %}
    {{ text }}
{% endif %}
{%- endmacro %}

{# 渲染表格 #}
{% macro render_table(headers, rows) -%}
{% if headers and rows %}
【表格开始】
表头：{{ headers | join(' | ') }}
{% for row in rows %}
{{ row | join(' | ') }}
{% endfor %}
【表格结束】
{% endif %}
{%- endmacro %}

{# 渲染编号列表 #}
{% macro numbered_list(items, prefix="") -%}
{% if items %}
{% for item in items %}
{{ prefix }}{{ loop.index }}. {{ item }}
{% endfor %}
{% endif %}
{%- endmacro %}

{# 渲染要素表（键值对形式） #}
{% macro key_value_table(data) -%}
{% if data %}
【表格开始】
表头：要素 | 内容
{% for key, value in data.items() %}
{{ key }} | {{ value if value else "[待填写]" }}
{% endfor %}
【表格结束】
{% endif %}
{%- endmacro %}

{# 渲染可选段落（字段非空时才显示标题和内容） #}
{% macro optional_section(title, content) -%}
{% if content %}
{{ title }}
    {{ content }}
{% endif %}
{%- endmacro %}

{# 渲染带条件的表格（表格数据可能为空） #}
{% macro conditional_table(headers, rows, empty_text="暂无相关数据。") -%}
{% if rows and rows | length > 0 %}
{{ render_table(headers, rows) }}
{% else %}
{{ empty_text }}
{% endif %}
{%- endmacro %}
