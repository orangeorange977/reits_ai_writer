# 扫描页视觉精读需要；不用可留空（系统会回退本地 OCR）
MOONSHOT_API_KEY=
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
MOONSHOT_MODEL=kimi-k3
# 如主模型不支持图片，在这里指定账号可用的视觉模型；留空=沿用主模型
MOONSHOT_VISION_MODEL=

# DeepSeek（默认文本生成模型；读图任务仍走 Moonshot）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 天眼查 MCP（企业数据）密钥，不用可留空
TIANYANCHA_MCP_KEY=

# ===== 登录认证（步骤 3.2）=====
# JWT 签名密钥：部署前用 `python3 -c "import secrets;print(secrets.token_hex(32))"` 生成
JWT_SECRET=replace-with-random-hex
# 初始管理员密码（首次启动创建 admin 用；留空则自动生成随机密码打印到控制台）
ADMIN_INIT_PASSWORD=

# ===== 部署配置（步骤 3.6）=====
# 监听地址/端口：本地体验留空即可（默认 127.0.0.1:8000）；
# 服务器部署设 APP_HOST=0.0.0.0，由 Nginx 反代对外
APP_HOST=
APP_PORT=
# CORS 白名单（逗号分隔）：前后端同源部署留空即可（不挂 CORS 最安全）；
# 仅当前后端分域名部署时填正式域名，如 https://reit.example.com
CORS_ORIGINS=
# AI 接口限流：每用户每分钟最多调用次数（防 Kimi key 被刷），0=不限
AI_RATE_LIMIT_PER_MINUTE=10
