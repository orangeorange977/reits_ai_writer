      "no": 31,
      "chapter": "五、项目合规情况 > （一）符合宏观管理政策要求情况",
      "phase": 5,
      "category": "主观填写",
      "target": {
        "type": "paragraph_multi_section",
        "desc": "标准答案本节 5 个编号小节、约25段/3700字。每小节 = 逐份政策原文摘要段×N + 项目符合性论证段×1。政策原文取 industry_knowledge.json 的 macro_policies（按 level 分国家级/省级/行业标准），项目符合性必须用 compliance.macro_policies.conformity_metrics 的实测值对标政策目标数值。",
        "sections": [
          "1.项目符合国家重大战略、国家宏观调控政策、国民经济和社会发展总体规划情况",
          "2.项目符合有关专项规划和区域规划（实施方案）情况",
          "3.项目符合《产业结构调整指导目录》和相关行业政策规定的情况",
          "4.项目符合外资准入规定",
          "5.其他专项政策符合情况（数据中心项目通常为绿电/可再生能源政策）"
        ]
      },
      "data_deps": [
        "compliance.macro_policies.items[*]",
        "compliance.macro_policies.conformity_conclusions[*]",
        "compliance.macro_policies.conformity_metrics.*",
        "compliance.foreign_investment_access.*"
      ],
      "knowledge_refs": [
        "industry_knowledge.json:<行业>.macro_policies",
        "text_templates.json:paragraph_templates.macro_policy_<行业>"
      ],
      "fill_plan_hint": {
        "paragraphs": "由 ch5 子agent 生成；每小节结构固定为「政策段×N + 论证段×1」，政策段以「YYYY年M月，{发布机关}发布《{名称}》，……」开头并写出目标数值",
        "min_scale": "5小节合计不少于 20 段 / 3000 字（对标标准答案 25段/3700字）"
      }
    },
