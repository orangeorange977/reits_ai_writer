      "group": "违法违规和信用情况",
      "label": "实际查询网站",
      "source_role": "originator_credit",
      "strategy": "document_list",
      "extract_prompt": "只列出信用查询底稿中实际出现且有查询结果的网站，重点识别信用中国、国家企业信用信息公示系统、中国执行信息公开网；缺失的网站应明示。",
      "required": true
    },
    {
      "id": "credit.conclusion",
      "section_id": "2.3",
      "group": "违法违规和信用情况",
      "label": "严重违法失信命中情况",
      "source_role": "originator_credit",
      "strategy": "document_conclusion",
      "extract_prompt": "核对各查询结果是否命中失信被执行人、重大税收违法案件当事人或涉金融严重失信记录；有命中时禁止输出“不存在”。",
      "required": true
    },
    {
      "id": "credit.attachment",
      "section_id": "2.3",
      "group": "违法违规和信用情况",
      "label": "信用查询附件编号",
      "source_role": "originator_credit",
      "strategy": "path_number",
      "required": true
    }
  ],
  "financial_metrics": [
    {
      "id": "total_assets",
      "label": "总资产",
      "value_type": "amount",
      "unit": "万元",
      "extract_prompt": "取当期合并资产负债表“资产总计”；保留报表原单位并统一换算为万元，记录换算公式。",
      "required": true
    },
    {
      "id": "total_liabilities",
      "label": "总负债",
      "value_type": "amount",
      "unit": "万元",
      "extract_prompt": "取当期合并资产负债表“负债合计”；保留报表原单位并统一换算为万元，记录换算公式。",
      "required": true
    },
    {
      "id": "debt_ratio",
      "label": "资产负债率",
      "value_type": "percentage",
      "unit": "%",
      "extract_prompt": "使用同一期合并口径的总负债÷总资产×100%计算，保留两位小数；不直接抄用不明口径的比率。",
      "required": true
    },
    {
      "id": "revenue",
      "label": "营业收入",
      "value_type": "amount",
      "unit": "万元",
      "extract_prompt": "取当期合并利润表“一、营业总收入”，如无该科目再核对“营业收入”；保留原单位并换算为万元。",
      "required": true
    },
    {
      "id": "net_profit",
      "label": "净利润",
      "value_type": "amount",
      "unit": "万元",
      "extract_prompt": "取当期合并利润表“五、净利润”；不取母公司单体表或归属于母公司所有者的净利润替代；换算为万元。",
      "required": true
    },
    {
      "id": "ebitda",
      "label": "息税折旧摊销前利润（EBITDA）",
      "value_type": "amount",
      "unit": "万元",
      "required": false,
      "default_disabled": true
    },
    {
      "id": "operating_cash_flow",
      "label": "经营活动产生的现金流量净额",
      "value_type": "amount",
      "unit": "万元",
      "extract_prompt": "取当期合并现金流量表“经营活动产生的现金流量净额”；保留原单位并换算为万元。",
      "required": true
    }
  ],
  "validations": [
    {
      "id": "project_name_crosscheck",
