  "generation_templates": {
    "1.1": {
      "id": "1",
      "title": "（一）项目概况",
      "blocks": [
        {
          "type": "p",
          "template": "本项目名称是{{project.name}}，标的资产为{{project.subproject_name}}，位于{{project.location_detail}}。资产范围为{{project.asset_scope}}，总体建设规模为{{project.scale_total}}万元，土地面积为{{project.land_area}}㎡，建筑面积为{{project.building_area}}㎡，机柜共{{project.cabinet_count}}个，于{{project.operation_start}}开始运营。{{project.subproject_name}}于价值时点{{project.valuation_date}}的资产评估值为{{project.appraisal_value}}亿元。本项目类型为{{project.type}}。",
          "field_formats": {
            "project.location_detail": {
              "fallback_field": "project.location",
              "merge_location_field": "project.location"
            },
            "project.asset_scope": {
              "truncate_before": ["，具体范围", "具体范围"]
            },
            "project.appraisal_value": {"divide": 10000, "decimals": 2}
          },
          "src_fields": [
            "project.name",
            "project.subproject_name",
            "project.location",
            "project.location_detail",
            "project.asset_scope",
            "project.scale_total",
            "project.land_area",
            "project.building_area",
            "project.cabinet_count",
            "project.operation_start",
            "project.valuation_date",
            "project.appraisal_value",
            "project.type"
          ]
        },
        {
          "type": "overview_table",
          "caption_prefix": "表 1-1 ",
          "caption_fallback": "项目概况",
          "src_source_role": "project_overview_table",
          "src_quote": "项目概况表整表直接复制"
        },
        {
          "type": "p",
          "template": "注：{{const.NOTE}}",
          "src_fields": []
        }
      ]
    },
    "2.3": {
      "id": "3",
      "title": "（三）发起人（原始权益人）情况",
      "blocks": [
        {
          "type": "p",
          "template": "1、{{originator.company_name}}",
