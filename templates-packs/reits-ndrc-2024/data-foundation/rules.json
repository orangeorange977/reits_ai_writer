          ]
        },
        {
          "type": "p",
          "template": "（1）基本信息",
          "src_fields": []
        },
        {
          "type": "kv",
          "caption": "表 2-2 原始权益人基本信息表",
          "src_fields": [
            "originator.company_name",
            "originator.legal_representative",
            "originator.actual_controller",
            "originator.established_date",
            "originator.registered_capital",
            "originator.registered_address",
            "originator.main_business",
            "originator.issued_reits",
            "originator.returned_projects"
          ],
          "rows": [
            {
              "field_id": "originator.company_name",
              "label": "公司名称"
            },
            {
              "field_id": "originator.legal_representative",
              "label": "法定代表人"
            },
            {
              "field_id": "originator.actual_controller",
              "label": "实际控制人"
            },
            {
              "field_id": "originator.established_date",
              "label": "成立日期"
            },
            {
              "field_id": "originator.registered_capital",
              "label": "注册资本"
            },
            {
              "field_id": "originator.registered_address",
              "label": "注册地址"
            },
            {
              "field_id": "originator.main_business",
              "label": "主营业务"
            },
            {
              "field_id": "originator.issued_reits",
              "label": "已发行基础设施REITs情况"
            },
            {
              "field_id": "originator.returned_projects",
              "label": "最近12个月内申报的基础设施REITs项目被国家发展改革委退回情况"
            },
            {
              "label": "项目联系人姓名及职务",
              "value": "（待定）"
            },
            {
              "label": "联系方式",
              "value": "（待定）"
            }
          ]
        },
        {
          "type": "p",
          "template": "（2）财务状况",
          "src_fields": []
        },
        {
          "type": "p",
          "template": "{{originator.company_name}}最近3个会计年度及一期财务报表按照{{finance.accounting_standard}}编制。已审计年度由{{finance.auditor}}审计并出具{{finance.audit_opinion}}审计意见；最近一期{{finance.latest_period_status}}。财务数据均采用{{finance.scope}}口径。",
          "src_fields": [
            "finance.accounting_standard",
            "finance.auditor",
            "finance.audit_opinion",
            "finance.latest_period_status",
            "finance.scope"
          ]
        },
        {
          "type": "financial_grid",
          "caption": "表 2-3 原始权益人最近3个会计年度及一期主要财务指标",
          "src_role_prefix": "audit_report_",
          "src_quote": "合并财务报表及附注"
        },
        {
          "type": "p",
          "if_all": [
            "finance.analysis"
          ],
          "template": "{{finance.analysis}}",
          "else_template": "【待补充重大财务波动原因说明；在原因底稿缺失时仅描述客观变动】",
          "src_fields": [
            "finance.analysis"
          ]
        },
        {
          "type": "p",
          "template": "（3）违法违规和信用情况",
          "src_fields": []
        },
        {
          "type": "p",
          "template": "1）违法违规情况",
          "src_fields": []
        },
        {
          "type": "p",
          "if_all": [
            "compliance.violation_conclusion",
            "compliance.safety_conclusion",
            "compliance.commitment_quote"
          ],
          "template": "{{originator.company_name}}近3年在投资建设、生产运营、市场监管、税务等方面{{compliance.violation_conclusion}}，{{compliance.safety_conclusion}}重大安全生产事故。{{compliance.commitment_date}}，{{originator.company_name}}出具《{{compliance.commitment_name}}》，就自身运营情况承诺：“{{compliance.commitment_quote}}”相关情况详见附件{{compliance.commitment_attachment}}。",
          "else_template": "【待补充或提取原始权益人运营情况承诺函及监管查询结果，不输出无违法违规结论】",
          "src_source_role": "originator_commitment",
          "src_quote": "运营情况承诺函"
        },
        {
          "type": "p",
          "template": "2）信用状况",
          "src_fields": []
        },
        {
          "type": "p",
          "if_all": [
            "credit.conclusion"
          ],
          "template": "截至{{credit.cutoff_date}}，经查询{{credit.sites}}，基于查询结果，最近三年，{{originator.company_name}}{{credit.conclusion}}因严重违法失信行为被有权部门认定为失信被执行人、重大税收违法案件当事人或涉金融严重失信人的记录，详见附件{{credit.attachment}}。",
          "else_template": "【待更新或提取信用查询结果，不沿用方法论示例日期和结论】",
          "src_source_role": "originator_credit",
          "src_quote": "原始权益人信用记录查询结果"
        }
      ]
    }
  },
  "audit_checks": {
    "1.1": {
      "checklist": [
        "项目名称、行业领域、资产所在地、资产范围、建设规模、申报基准日和评估净值必须在两份人工摘要之间逐项核对，不一致须明确提示，不得自行选用一侧覆盖另一侧",
        "表1-1 必须与当前项目映射到“项目概况整表”的人工输入原表一致，不得被模型改写字段顺序、单位、标点或合同编号",
        "评估值总额、评估净值总额与各子项目合计不一致时必须报错，不得自动调平",
        "正文中的数字、单位、日期必须能回指人工摘要中的具体字段，不得使用方法论 #示例# 中的数值",
        "项目概况表缺失或人工字段为空时必须使用【待业务人员填写】/【注意：缺少……】类提示，不得留空或编造"
      ]
    },
    "2.3": {
      "checklist": [
        "公司名称必须与摘要表、营业执照和材料封面中的原始权益人一致；法定代表人/成立日期/注册资本/注册地址须与最新营业执照逐项一致，天眼查冲突以营业执照为准",
        "资产负债率必须按表内总负债、总资产复算，差异超过 0.01 个百分点须报错；营业收入/净利润/经营现金流须与各期合并报表一致",
        "财务波动原因没有底稿支持时不得输出确定性原因",
        "违法违规结论与信用结论必须分别核验，不得用“无失信”替代“无重大违法违规”；信用记录如有命中项不得套用“不存在”表述",
        "不得使用方法论 #示例# 中的任何日期、结论或数值；承诺函/信用查询缺失时必须使用【待补充】类提示而非编造结论"
      ]
    }
  }
