  "source_roles": [
    {
      "id": "user_summary",
      "label": "用户填写摘要表",
      "input_kind": "manual_input",
      "input_slot": "project_summary",
      "required": true,
      "priority": 1
    },
    {
      "id": "project_overview_table",
      "label": "用户填写项目概况表",
      "input_kind": "manual_input",
      "input_slot": "project_overview",
      "required": true,
      "priority": 1
    },
    {
      "id": "originator_license",
      "label": "原始权益人营业执照",
      "selector": {
        "document_type": "business_license",
        "extensions": [".pdf", ".jpg", ".jpeg", ".png"],
        "filename_keywords_any": ["营业执照"],
        "path_keywords_any": ["参与主体", "原始权益人", "发起人"],
        "subject_ref": "originator.company_name",
        "prefer": "latest"
      },
      "match_prompt": "在当前项目目录中找到原始权益人的最新营业执照；如同目录有项目公司或运营机构执照，必须用当前原始权益人名称区分。",
      "required": true,
      "priority": 1
    },
    {
      "id": "originator_commitment",
      "label": "原始权益人自身运营情况承诺函",
      "selector": {
        "document_type": "originator_operation_commitment",
        "extensions": [".pdf", ".docx", ".jpg", ".jpeg", ".png"],
        "filename_keywords_all": ["承诺函"],
        "filename_keywords_any": ["自身运营情况", "运营情况"],
        "path_keywords_any": ["参与主体", "原始权益人", "发起人"],
        "subject_ref": "originator.company_name"
      },
      "match_prompt": "在当前项目目录中找到原始权益人关于自身运营情况的承诺函，不要选项目公司、运营机构或其他主题的承诺函。",
      "required": true,
      "priority": 1
    },
    {
      "id": "originator_credit",
      "label": "原始权益人信用记录查询结果",
      "selector": {
        "document_type": "originator_credit_search_result",
        "extensions": [".pdf", ".docx", ".jpg", ".jpeg", ".png"],
        "filename_keywords_any": ["原始权益人信用记录", "原始权益人信用查询", "信用记录", "信用查询", "信用报告"],
        "path_keywords_any": ["原始权益人", "发起人", "参与主体"],
        "subject_ref": "originator.company_name",
        "prefer": "latest"
      },
      "match_prompt": "在当前项目目录中找到原始权益人的信用记录或信用查询结果，不要选项目公司或中介机构的信用材料。",
      "required": true,
      "priority": 1
    },
    {
      "id": "audit_reports",
      "label": "原始权益人最近3个会计年度及一期财务报告",
      "selector": {
        "document_type": "originator_financial_report",
        "extensions": [".pdf", ".docx", ".xlsx", ".xlsm"],
        "filename_keywords_any": ["审计报告", "财务报表", "财务报告"],
        "path_keywords_any": ["原始权益人", "审计的财务报告"],
        "exclude_keywords_any": ["备考财务报表", "项目公司"],
        "subject_ref": "originator.company_name",
        "repeat_by": "reporting_periods"
      },
      "match_prompt": "先由申报基准日计算 n-3、n-2、n-1 及 n 期间，再从当前项目目录中逐期选择原始权益人的审计报告或最近一期财务报表。",
      "required": true,
      "priority": 1
    },
    {
      "id": "project_materials",
      "label": "项目权属与申报说明材料",
      "selector": {
        "document_type": "project_ownership_material",
        "extensions": [".pdf", ".docx", ".rtf"],
        "filename_keywords_any": ["权属", "不动产权", "项目说明", "申报材料"],
        "path_keywords_any": ["项目基本条件", "权属"],
        "exclude_keywords_any": ["拟投资项目", "募集资金用途"]
      },
      "match_prompt": "从当前项目目录中选择能明确证明项目权利类型的权属材料或申报说明；如候选不唯一，保留候选供业务核对。",
      "required": false,
      "priority": 2
    },
    {
      "id": "project_property_certificate",
      "label": "基础设施项目不动产权属证书",
      "selector": {
        "document_type": "project_property_certificate",
        "extensions": [".pdf", ".docx", ".jpg", ".jpeg", ".png"],
        "filename_keywords_any": ["不动产权证书", "房屋所有权证", "产权证"],
        "path_keywords_any": ["项目所有权", "项目基本条件", "不动产权"],
        "exclude_keywords_any": ["拟投资项目", "募集资金用途"],
        "subject_ref": "project.subproject_name"
      },
      "match_prompt": "从当前项目目录中选择底层基础设施项目本身的不动产权属证书，不选择募集资金拟投资项目或其他地区资产；候选不唯一时保留候选供业务核对。",
      "required": false,
      "priority": 2
    }
  ],
