  "financial_metrics": [
    {
      "id": "total_assets",
      "label": "总资产",
      "value_type": "amount",
      "unit": "万元",
      "extract_prompt": "取当期合并资产负债表“资产总计”；保留报表原单位并统一换算为万元，记录换算公式。",
      "required": true
    },
    {
      "id": "total_liabilities",
      "label": "总负债",
      "value_type": "amount",
      "unit": "万元",
      "extract_prompt": "取当期合并资产负债表“负债合计”；保留报表原单位并统一换算为万元，记录换算公式。",
      "required": true
    },
    {
      "id": "debt_ratio",
      "label": "资产负债率",
      "value_type": "percentage",
      "unit": "%",
      "extract_prompt": "使用同一期合并口径的总负债÷总资产×100%计算，保留两位小数；不直接抄用不明口径的比率。",
      "required": true
    },
    {
      "id": "revenue",
      "label": "营业收入",
      "value_type": "amount",
      "unit": "万元",
      "extract_prompt": "取当期合并利润表“一、营业总收入”，如无该科目再核对“营业收入”；保留原单位并换算为万元。",
      "required": true
    },
    {
      "id": "net_profit",
      "label": "净利润",
      "value_type": "amount",
      "unit": "万元",
      "extract_prompt": "取当期合并利润表“五、净利润”；不取母公司单体表或归属于母公司所有者的净利润替代；换算为万元。",
      "required": true
    },
    {
      "id": "ebitda",
      "label": "息税折旧摊销前利润（EBITDA）",
      "value_type": "amount",
      "unit": "万元",
      "extract_prompt": "按业务口径计算：净利润+固定资产折旧+投资性房地产折旧+油气资产折耗+生产性生物资产折旧+无形资产摊销+使用权资产摊销。优先定位现金流量表补充资料，不得重复加总；任一组成项缺失时留空并提示补充。",
      "required": true
    },
    {
      "id": "operating_cash_flow",
      "label": "经营活动产生的现金流量净额",
      "value_type": "amount",
      "unit": "万元",
      "extract_prompt": "取当期合并现金流量表“经营活动产生的现金流量净额”；保留原单位并换算为万元。",
      "required": true
    }
  ],
